    "Dev": ["python", "rust", "javascript", "typescript", "java", "golang", "programming", "framework", "compiler", "react", "django", "fastapi", "language"],
    "Data Engineering": ["etl", "elt", "spark", "pyspark", "data warehouse", "lakehouse", "databricks", "snowflake", "dbt", "kafka", "flink", "airflow", "pipeline", "postgres", "database", "iceberg", "duckdb"],
    "Cloud/DevOps": ["aws", "azure", "gcp", "google cloud", "cloud", "kubernetes", "docker", "ci/cd", "terraform", "serverless", "devops", "infrastructure"],
    "Dev Tools": ["github", "ide", "vs code", "vscode", "jetbrains", "copilot", "api", "cli", "git", "debugger", "productivity"],
    "Emerging": ["quantum", "research", "startup", "robot", "chip", "semiconductor", "breakthrough", "funding", "raises", "innovation", "nvidia"]
  },

  "smtp": {
    "host": "smtp.gmail.com",
    "port": 587,
    "username": "",
    "password_env": "DIGEST_SMTP_PASSWORD",
    "from": "TechPulse <you@example.com>"
  }
