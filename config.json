{
  "db_path": "digest.db",
  "output_dir": "output",
  "newsletter_name": "TechPulse",
  "max_items_per_digest": 10,
  "max_items_per_topic": 3,
  "lookback_hours": 192,
  "max_age_days": 8,
  "schedule": { "weekday": "Saturday", "hour": 10, "timezone": "Europe/Berlin" },

  "ai": {
    "provider": "auto",
    "openai_model": "gpt-4.1-mini",
    "claude_model": "claude-opus-5-5",
    "ollama_model": "llama3.2:3b",
    "ollama_url": "http://localhost:11434",
    "delay_seconds": 4,
    "article_chars": 2500
  },

  "hackernews": { "enabled": true, "limit": 40, "weight": 0.7 },

  "rss_feeds": [
    { "name": "OpenAI News", "url": "https://openai.com/news/rss.xml", "weight": 1.8, "topic": "AI", "limit": 15 },
    { "name": "Google DeepMind", "url": "https://deepmind.google/blog/rss.xml", "weight": 1.6, "topic": "AI", "limit": 15 },
    { "name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "weight": 1.4, "topic": "AI", "limit": 15 },
    { "name": "Hermes Agent releases", "url": "https://github.com/NousResearch/hermes-agent/releases.atom", "weight": 1.8, "topic": "Automation", "limit": 3 },
    { "name": "MCP servers releases", "url": "https://github.com/modelcontextprotocol/servers/releases.atom", "weight": 1.5, "topic": "MCP", "limit": 3 },
    { "name": "Python Blog", "url": "https://blog.python.org/feeds/posts/default", "weight": 1.2, "topic": "Dev", "limit": 10 },
    { "name": "Databricks Blog", "url": "https://www.databricks.com/feed", "weight": 1.4, "topic": "Data Engineering", "limit": 10 },
    { "name": "dbt Blog", "url": "https://www.getdbt.com/blog/rss.xml", "weight": 1.3, "topic": "Data Engineering", "limit": 10 },
    { "name": "Confluent Blog", "url": "https://www.confluent.io/rss.xml", "weight": 1.2, "topic": "Data Engineering", "limit": 10 },
    { "name": "Apache News", "url": "https://news.apache.org/feed", "weight": 1.2, "topic": "Data Engineering", "limit": 10 },
    { "name": "AWS News Blog", "url": "https://aws.amazon.com/blogs/aws/feed/", "weight": 1.4, "topic": "Cloud/DevOps", "limit": 15 },
    { "name": "Kubernetes Blog", "url": "https://kubernetes.io/feed.xml", "weight": 1.2, "topic": "Cloud/DevOps", "limit": 10 },
    { "name": "Docker Blog", "url": "https://www.docker.com/feed/", "weight": 1.1, "topic": "Cloud/DevOps", "limit": 10 },
    { "name": "Cloudflare Blog", "url": "https://blog.cloudflare.com/rss/", "weight": 1.1, "topic": "Cloud/DevOps", "limit": 10 },
    { "name": "GitHub Blog", "url": "https://github.blog/feed/", "weight": 1.3, "topic": "Dev Tools", "limit": 10 },
    { "name": "VS Code Blog", "url": "https://code.visualstudio.com/feed.xml", "weight": 1.2, "topic": "Dev Tools", "limit": 5 },
    { "name": "JetBrains Blog", "url": "https://blog.jetbrains.com/feed/", "weight": 1.0, "topic": "Dev Tools", "limit": 10 },
    { "name": "MIT Technology Review", "url": "https://www.technologyreview.com/feed/", "weight": 1.2, "topic": "Emerging", "limit": 10 },
    { "name": "Ars Technica", "url": "https://feeds.arstechnica.com/arstechnica/index", "weight": 0.9, "limit": 20 },
    { "name": "TechCrunch", "url": "https://techcrunch.com/feed/", "weight": 0.9, "limit": 20 }
  ],

  "extra_sources": [
    {
      "type": "mcp_registry", "name": "MCP Registry (new)", "weight": 1.4, "topic": "MCP", "days": 7,
      "keywords": ["automat", "workflow", "agent", "browser", "schedul", "n8n", "zapier", "pipeline", "integrat", "rpa", "trigger", "webhook", "orchestrat"]
    },
    {
      "type": "github_search", "name": "GitHub: new MCP tools", "weight": 1.3, "topic": "MCP", "days": 7, "min_stars": 15,
      "queries": ["mcp server automation", "model context protocol"]
    },
    {
      "type": "github_search", "name": "GitHub: agent automation", "weight": 1.2, "topic": "Automation", "days": 7, "min_stars": 25,
      "queries": ["ai agent automation", "hermes agent"]
    },
    {
      "type": "hn_search", "name": "HN: AI, MCP & agents", "weight": 0.9, "days": 7,
      "queries": ["MCP", "Model Context Protocol", "Anthropic", "Claude", "OpenAI", "Hermes Agent", "AI agents", "n8n", "Spark", "Kubernetes"]
    },
    { "type": "hf_papers", "name": "HF Daily Papers", "weight": 0.9, "topic": "Emerging", "limit": 15 },
    { "type": "hf_trending", "name": "HF Trending Models", "weight": 0.8, "topic": "AI", "kind": "models", "limit": 5 }
  ],

  "topics": {
    "MCP": ["mcp", "model context protocol", "mcp server", "mcp client", "tool calling"],
