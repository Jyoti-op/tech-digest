# Copy this file to .env and fill it in. .env is git-ignored, so it never reaches GitHub.
DIGEST_SMTP_USER=yourname@gmail.com
DIGEST_SMTP_PASSWORD=your-16-char-gmail-app-password
# Optional: who receives it, as email|topics|frequency; separate people with ;
# DIGEST_SUBSCRIBERS=yourname@gmail.com|MCP,Automation,HuggingFace,AI|daily
# Optional: higher GitHub search rate limit
# GITHUB_TOKEN=
